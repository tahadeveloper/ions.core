# Application
APP_NAME=Ions
# 64-char hex signing key (JWT auth refuses to sign with anything < 32 bytes).
# Generate one with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# (php bin/ions make:key writes a fallback key to var/app.key instead;
#  setting APP_KEY here is preferred.)
APP_KEY=
APP_URL=http://localhost:8000
APP_DEBUG=true
TIME_ZONE=UTC

# Drivers (defaults shown; see config/cache.php, config/session.php, config/queue.php)
# CACHE_DRIVER=file
# SESSION_DRIVER=native
# QUEUE_CONNECTION=sync

# Database (see config/database.php; DB_CONNECTION=sqlite for a file DB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ions
DB_USERNAME=root
DB_PASSWORD=

# Mail (SMTP DSN built by the MailProvider)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Ions

# Filesystem: 'local' (public/uploads) or 's3' (set the AWS_* keys too)
FILESYSTEM_DISK=local
# AWS_BUCKET=
# AWS_DEFAULT_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
