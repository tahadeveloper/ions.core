{
    "name": "ionzile/app-skeleton",
    "description": "Host application skeleton for the Ions PHP framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ionzile/core": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
