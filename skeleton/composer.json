{
    "name": "ionzile/app-skeleton",
    "description": "Host application skeleton for the Ions PHP framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ionzile/core": "^4.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
