# PHPStan baseline — intentionally EMPTY.
#
# Phase 12.2 burned this baseline down to zero: every previously-suppressed
# level-5 error was either genuinely fixed (e.g. dead always-true logic in
# RouteListCommand) or replaced with a targeted, commented inline
# `@phpstan-ignore` at the call site for an irreducible vendor / optional-
# dependency seam (Cartalyst Sentinel's untyped __callStatic facade, the
# illuminate/redis optional dependency, base-vs-driver Connection methods,
# the framework container driving Illuminate facades). This mirrors the
# inline-ignore pattern already used by the level-8 core code
# (src/Auth/Providers/SentinelUserProvider.php).
#
# Keep this file empty. New first-party type debt must be fixed, not baselined.
parameters:
	ignoreErrors: []
