{
  "name": "ionzile/core",
  "description": "Ions core library",
  "type": "library",
  "autoload": {
    "psr-4": {
      "Ions\\": "src/"
    },
    "classmap": [
      "src/commands"
    ]
  },
  "authors": [
    {
      "name": "ahmedhamdi",
      "email": "taha.developer@outlook.com"
    }
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-openssl": "*",
    "ext-zip": "*",
    "cartalyst/sentinel": "^7.0",
    "filp/whoops": "^2.15",
    "illuminate/cache": "^10.0",
    "illuminate/console": "^10.0",
    "illuminate/container": "^10.0",
    "illuminate/database": "^10.0",
    "illuminate/events": "^10.0",
    "illuminate/filesystem": "^10.0",
    "illuminate/http": "^10.0",
    "illuminate/pagination": "^10.0",
    "illuminate/support": "^10.0",
    "illuminate/validation": "^10.0",
    "lcobucci/clock": "^3.3",
    "lcobucci/jwt": "^5.0",
    "league/flysystem": "^3.29.1",
    "league/flysystem-aws-s3-v3": "^3.29",
    "monolog/monolog": "^2.10.0",
    "peppeocchi/php-cron-scheduler": "^4.0",
    "psr/container": "^2.0",
    "spatie/ignition": "^1.15",
    "symfony/config": "^6.4.14",
    "symfony/mailer": "^6.4.18",
    "symfony/routing": "^6.4.18",
    "symfony/security-csrf": "^6.4.13",
    "symfony/translation": "^6.4.19",
    "symfony/yaml": "^6.4.20",
    "twig/twig": "^3.10",
    "vlucas/phpdotenv": "^5.6.1"
  },
  "autoload-dev": {
    "psr-4": {
      "IonsFixture\\": "tests/fixtures/app/src/"
    }
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.5",
    "friendsofphp/php-cs-fixer": "^3.64",
    "pestphp/pest": "^2.0",
    "phpstan/phpstan": "^2.0",
    "rector/rector": "^2.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "test": "pest",
    "stan": "phpstan analyse",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "rector": "rector process --dry-run",
    "qa": ["@cs", "@stan", "@test"]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
