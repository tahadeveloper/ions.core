includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        # Fixture models give HasIonsFactory a concrete usage so phpstan
        # analyses the trait (it is otherwise only consumed by host apps).
        - tests/fixtures/app/src/Models
    excludePaths:
        - src/commands/stubs/*
    treatPhpDocTypesAsCertain: false
    # Some @phpstan-ignore lines target errors only surfaced at the stricter
    # core level (level 8 in phpstan-core.neon); they are legitimately unmatched
    # at level 5, so don't fail the main gate on them.
    reportUnmatchedIgnoredErrors: false
