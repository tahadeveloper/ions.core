parameters:
    level: 8
    paths:
        - src/Security
        - src/Container
        - src/Http
        - src/Auth/Contracts
        - src/Auth/Providers
        - src/Auth/Http
        - src/Filesystem
        - src/Providers
        - src/Session
        - src/View
        - src/Console
        - src/Events
        - src/Queue
        - src/Media
        - src/Support
    scanFiles:
        - src/helpers.php
    # NO baseline — this code must be clean at level 8
    treatPhpDocTypesAsCertain: false
