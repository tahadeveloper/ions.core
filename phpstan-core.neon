parameters:
    level: 8
    paths:
        - src/Foundation/Discovery.php
        - src/Foundation/Doctor.php
        - src/Security
        - src/Container
        - src/Http
        - src/Auth/Contracts
        - src/Auth/Providers
        - src/Auth/Http
        - src/Filesystem
        - src/Providers
        - src/Session
        - src/View
        - src/Console
        - src/Database
        - src/Events
        - src/Mail
        - src/Notifications
        - src/Queue
        - src/Media
        - src/Support
        - src/Runtime
        - src/Testing
        # Fixture models give HasIonsFactory a concrete usage so phpstan
        # analyses the trait (it is otherwise only consumed by host apps).
        - tests/fixtures/app/src/Models
    scanFiles:
        - src/helpers.php
    # NO baseline — this code must be clean at level 8
    treatPhpDocTypesAsCertain: false
