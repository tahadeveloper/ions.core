# Application
APP_NAME=Taskflow
# 64-char hex signing key (JWT auth refuses to sign with anything < 32 bytes).
# Generate one with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# (php bin/ions make:key writes a fallback key to var/app.key instead;
#  setting APP_KEY here is preferred.)
APP_KEY=
APP_URL=http://localhost:8000
APP_DEBUG=true
TIME_ZONE=UTC
# Token gating GET /up?checks=1 (doctor JSON over HTTP); leave unset to keep
# the liveness probe only. Generate like APP_KEY.
# HEALTH_TOKEN=

# Drivers (defaults shown; see config/cache.php, config/session.php, config/queue.php)
# CACHE_DRIVER=file
# SESSION_DRIVER=native
# QUEUE_CONNECTION=sync

# Logging (see config/logging.php; channels: app / daily / stderr / stack)
# LOG_CHANNEL=app
# LOG_LEVEL=debug

# Database: SQLite by default (no external service). The file lives at
# database/database.sqlite — create it with `php bin/ions migrate`.
# Switch to MySQL by setting DB_CONNECTION=mysql plus the DB_* credentials.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=taskflow
# DB_USERNAME=root
# DB_PASSWORD=

# Mail (SMTP DSN built by the MailProvider)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@taskflow.test
MAIL_FROM_NAME=Taskflow

# Filesystem default disk: 'local' (PRIVATE — rooted at var/storage, not
# web-accessible; attachments are served only via the authorized download
# action) or 's3' (set the AWS_* keys too; download redirects to a presigned URL)
FILESYSTEM_DISK=local
# AWS_BUCKET=
# AWS_DEFAULT_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
