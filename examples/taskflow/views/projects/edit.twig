{% extends "layout.twig" %}
{% block title %}Edit project · Taskflow{% endblock %}
{% block body %}
    <h1>Edit project</h1>

    <form method="post" action="{{ appUrl('projects/' ~ project.id) }}">
        {{ ionToken('web') }}
        <label>Name
            <input type="text" name="name" value="{{ old('name', project.name) }}" autofocus>
        </label>
        <label>Note
            <textarea name="note" rows="3">{{ old('note', note) }}</textarea>
        </label>
        <button type="submit">Save changes</button>
    </form>
    <p class="note"><a href="{{ appUrl('projects/' ~ project.id) }}">Back to project</a></p>
{% endblock %}
