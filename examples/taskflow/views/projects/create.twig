{% extends "layout.twig" %}
{% block title %}New project · Taskflow{% endblock %}
{% block body %}
    <h1>New project</h1>

    <form method="post" action="{{ appUrl('projects') }}">
        {{ ionToken('web') }}
        <label>Name
            <input type="text" name="name" value="{{ old('name') }}" autofocus>
        </label>
        <label>Note
            <textarea name="note" rows="3">{{ old('note') }}</textarea>
        </label>
        <button type="submit">Create project</button>
    </form>
    <p class="note"><a href="{{ appUrl('projects') }}">Back to projects</a></p>
{% endblock %}
