<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ project.name }} · Shared board</title>
    <style>
        body {
            margin: 0; min-height: 100vh; padding: 2.5rem 1.5rem;
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
            color: #d8dce3; background: #101218;
        }
        main { width: 100%; max-width: 44rem; margin: 0 auto; }
        h1 { font-size: 1.5rem; color: #fff; margin: 0 0 0.4rem; }
        .badge { font-size: 0.8rem; color: #8b939f; }
        ul.list { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; gap: 0.5rem; }
        ul.list li {
            padding: 0.7rem 0.9rem; border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(255, 255, 255, 0.02);
            display: flex; justify-content: space-between; align-items: center;
        }
        .pill {
            font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 999px;
            background: rgba(99, 102, 241, 0.18); color: #c7d2fe;
        }
        .note { color: #8b939f; font-size: 0.85rem; }
    </style>
</head>
<body>
<main>
    <h1>{{ project.name }}</h1>
    <p class="badge">Read-only shared board</p>

    {% if tasks|length > 0 %}
        <ul class="list">
            {% for task in tasks %}
                <li>
                    <span>{{ task.title }}</span>
                    <span class="pill">{{ task.status }}</span>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="note">No tasks yet.</p>
    {% endif %}
</main>
</body>
</html>
